{
  "name": "etkinlik-platformu",
  "version": "0.0.0",
  "private": true,
  "description": "University event management and student engagement platform",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @etkinlik/shared && npm run build -w @etkinlik/api -w @etkinlik/web",
    "lint": "eslint . --max-warnings=0",
    "lint:openapi": "redocly lint docs/openapi/openapi.yaml --config docs/openapi/redocly.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @etkinlik/web"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@redocly/cli": "2.84.0",
    "@types/node": "26.6.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
