# Copy to .env and fill in every value. Secrets have no defaults on purpose:
# the stack refuses to start while a required value is missing.
# Generate secrets with:  openssl rand -hex 32

# --- Origin ---------------------------------------------------------------
# Single origin served by Caddy. Local: https://etkinlik.localhost
# Production: https://haber10da.net (fixed before launch; see docs/adr/0007)
APP_ORIGIN=https://etkinlik.localhost
# Host part of APP_ORIGIN, used by Caddy for TLS.
SITE_ADDRESS=etkinlik.localhost
NODE_ENV=production

# --- PostgreSQL (use URL-safe characters, e.g. hex) -------------------------
POSTGRES_USER=etkinlik
POSTGRES_DB=etkinlik
POSTGRES_PASSWORD=899c246008c7dfa2204ab276b1908b5db1dd1e40c84efa155fbe6276a0772e41

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=51d5d11fa939f687dac84d77d84cfb48ed1840d37e687c9ebf0c39594e3b8414

# --- Garage (S3-compatible object storage) --------------------------------
# rpc_secret must be exactly 64 hex characters.
GARAGE_RPC_SECRET=25d1e2558a57f83b12612f9efcaeb7d9ee858e87485fb91bba5fee87110e6ba5
GARAGE_ADMIN_TOKEN=eb75f6188cef261c18c91a9013d3bebb48b4d00444e41186e3d683d3d56a0c80

# --- Tuning (optional; must be positive) ----------------------------------
API_DB_POOL_SIZE=10
WORKER_DB_POOL_SIZE=5
LOG_LEVEL=info

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=

