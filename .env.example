# Copy to .env and fill in every value. Secrets have no defaults on purpose:
# the stack refuses to start while a required value is missing.
# Generate secrets with:  openssl rand -hex 32

# --- Origin ---------------------------------------------------------------
# Single origin served by Caddy. Local: https://etkinlik.localhost
# Production: https://haber10da.net (fixed before launch; see docs/adr/0007)
APP_ORIGIN=https://etkinlik.localhost
# Host part of APP_ORIGIN, used by Caddy for TLS.
SITE_ADDRESS=etkinlik.localhost
NODE_ENV=production

# --- PostgreSQL (use URL-safe characters, e.g. hex) -------------------------
POSTGRES_USER=etkinlik
POSTGRES_DB=etkinlik
POSTGRES_PASSWORD=

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=

# --- Garage (S3-compatible object storage) --------------------------------
# rpc_secret must be exactly 64 hex characters.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- Tuning (optional; must be positive) ----------------------------------
API_DB_POOL_SIZE=10
WORKER_DB_POOL_SIZE=5
LOG_LEVEL=info

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=

# --- Identity provider (Keycloak under /idp; ADR 0011) ---------------------
OIDC_CLIENT_SECRET=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# Corporate e-mail of the first administrator; assigned on first login.
INITIAL_ADMIN_EMAIL=
# Password of every fictional demo account (at least 12 characters).
DEMO_USER_PASSWORD=

# --- Local development only (compose.dev.yaml) ----------------------------
# Host ports (127.0.0.1 only); change if already in use on your machine.
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_GARAGE_PORT=3900
DEV_KEYCLOAK_PORT=8080
