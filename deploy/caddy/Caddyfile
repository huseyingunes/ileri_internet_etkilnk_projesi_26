{
	# Admin API is not exposed outside the container.
	admin localhost:2019
	servers {
		protocols h1 h2 h3
	}
}

# Single origin: static PWA + /api reverse proxy + /idp identity provider.
# CORS is never enabled. SITE_ADDRESS is the host of APP_ORIGIN
# (etkinlik.localhost locally, haber10da.net in production).
{$SITE_ADDRESS} {
	encode zstd gzip

	# Headers for every response, including the identity provider.
	header {
		# HSTS starts short and is raised once the deployment is stable (docs/isletim-kilavuzu.md).
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		-Server
		-Via
	}

	# Keycloak plays the university SSO (ADR 0011). Its admin console is never public;
	# use the development port or `kcadm.sh` inside the container instead.
	@idp_admin path /idp/admin /idp/admin/*
	respond @idp_admin 404

	handle /idp/* {
		# Keycloak sends its own CSP and frame options for its pages.
		reverse_proxy {$IDP_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}

	handle /api/* {
		header {
			Cross-Origin-Opener-Policy "same-origin-allow-popups"
			Cross-Origin-Resource-Policy "same-origin"
		}
		reverse_proxy {$API_UPSTREAM} {
			# The API generates request ids itself; never forward a client-supplied one.
			header_up -X-Request-Id
			# Liveness of the upstream is checked by Compose; Caddy only retries briefly on deploy.
			lb_try_duration 5s
		}
	}

	handle {
		header {
			Cross-Origin-Opener-Policy "same-origin-allow-popups"
			Cross-Origin-Resource-Policy "same-origin"
			Reporting-Endpoints "csp=\"/api/v1/security-reports\""
			# The bundle has no inline code, so 'self' needs no hashes. Any inline script added
			# later must be allowed by its sha256 hash, never with 'unsafe-inline'.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self' {$APP_ORIGIN}/idp/; upgrade-insecure-requests; report-to csp"
			# Trusted Types start in report-only mode; enforce once reports stay at zero.
			Content-Security-Policy-Report-Only "require-trusted-types-for 'script'; trusted-types 'none'; report-to csp"
		}

		root * /srv

		# Version-stamped build output is immutable.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# The shell, service worker and manifest are always revalidated (network first).
		@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
