{
  "name": "@etkinlik/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "test": "npm run prisma:generate && vitest run --project unit",
    "test:integration": "npm run prisma:generate && vitest run --project integration"
  },
  "dependencies": {
    "@etkinlik/shared": "0.0.0",
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "11.20.0",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.3",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.2",
    "@testcontainers/redis": "12.2.2",
    "@types/express": "5.0.6",
    "prisma": "7.10.1",
    "testcontainers": "12.2.2",
    "unplugin-swc": "2.0.0"
  }
}
