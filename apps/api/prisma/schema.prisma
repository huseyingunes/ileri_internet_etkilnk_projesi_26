  daily_ballots                           daily_ballots[]
  event_photos                            event_photos[]
  event_tags                              event_tags[]
  users_events_advisor_user_idTousers     users?             @relation("events_advisor_user_idTousers", fields: [advisor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_events_approved_by_user_idTousers users?             @relation("events_approved_by_user_idTousers", fields: [approved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  media_objects                           media_objects?     @relation(fields: [cover_media_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_events_created_by_user_idTousers  users              @relation("events_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  communities                             communities?       @relation(fields: [organizer_community_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_events_organizer_user_idTousers   users?             @relation("events_organizer_user_idTousers", fields: [organizer_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  excuses                                 excuses[]
  ratings                                 ratings[]
  reason_prompts                          reason_prompts[]
  score_ledger                            score_ledger[]

  @@index([advisor_user_id])
  @@index([approved_by_user_id])
  @@index([cover_media_id])
  @@index([created_by_user_id])
  @@index([organizer_community_id])
  @@index([organizer_user_id])
  @@index([starts_at])
