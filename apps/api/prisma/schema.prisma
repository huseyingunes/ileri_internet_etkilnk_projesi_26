  @@unique([event_id, student_user_id], map: "attendances_unique")
  @@index([student_user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id            BigInt   @id @default(autoincrement())
  actor_user_id BigInt?
  action        String
  entity_type   String
  entity_id     BigInt?
  details       Json     @default("{}")
  request_id    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  public_id     String   @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_user_id])
  @@index([created_at])
