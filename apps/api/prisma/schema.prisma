}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model communities {
  id                 BigInt               @id @default(autoincrement())
  public_id          String               @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String               @unique
  description        String               @default("")
  archived_at        DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  community_advisors community_advisors[]
  community_members  community_members[]
  events             events[]
}

model community_advisors {
  community_id    BigInt
  advisor_user_id BigInt
  assigned_at     DateTime    @default(now()) @db.Timestamptz(6)
  users           users       @relation(fields: [advisor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  communities     communities @relation(fields: [community_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([community_id, advisor_user_id])
  @@index([advisor_user_id])
}

model community_members {
  community_id BigInt
  user_id      BigInt
  joined_at    DateTime    @default(now()) @db.Timestamptz(6)
  communities  communities @relation(fields: [community_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([community_id, user_id])
  @@index([user_id])
}

